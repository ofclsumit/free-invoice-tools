// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Business Details
  businessName  String?
  gstin         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  phone         String?
  logo          String?
  signature     String?
  upiId         String?
  bankName      String?
  bankAccount   String?
  bankIfsc      String?
  currency      String    @default("INR")
  invoicePrefix String    @default("INV")
  quotePrefix   String    @default("QUO")
  nextInvoiceNo Int       @default(1)
  nextQuoteNo   Int       @default(1)

  // Relations
  accounts      Account[]
  sessions      Session[]
  clients       Client[]
  invoices      Invoice[]
  quotations    Quotation[]
  templates     Template[]
  settings      Settings?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id         String   @id @default(cuid())
  userId     String
  name       String
  email      String?
  phone      String?
  gstin      String?
  address    String?
  city       String?
  state      String?
  pincode    String?
  country    String   @default("India")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices   Invoice[]
  quotations Quotation[]

  @@map("clients")
}

model Invoice {
  id              String        @id @default(cuid())
  userId          String
  clientId        String?
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  status          String @default("DRAFT")
  currency        String        @default("INR")
  
  // Business snapshot at invoice time
  businessName    String?
  businessGstin   String?
  businessAddress String?
  businessLogo    String?
  
  // Client snapshot at invoice time
  clientName      String
  clientEmail     String?
  clientPhone     String?
  clientGstin     String?
  clientAddress   String?
  
  // Financial
  subtotal        Float         @default(0)
  discountAmount  Float         @default(0)
  taxAmount       Float         @default(0)
  cgstAmount      Float         @default(0)
  sgstAmount      Float         @default(0)
  igstAmount      Float         @default(0)
  totalAmount     Float         @default(0)
  
  // Metadata
  notes           String?
  terms           String?
  signature       String?
  templateId      String?
  publicToken     String?       @unique
  viewedAt        DateTime?
  paidAt          DateTime?
  sentAt          DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client?       @relation(fields: [clientId], references: [id])
  items           InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  hsnCode     String?
  quantity    Float
  unit        String?
  rate        Float
  discount    Float    @default(0)
  gstRate     Float    @default(18)
  gstType     String @default("CGST_SGST")
  amount      Float
  taxAmount   Float    @default(0)
  total       Float
  sortOrder   Int      @default(0)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Quotation {
  id              String          @id @default(cuid())
  userId          String
  clientId        String?
  quoteNumber     String
  quoteDate       DateTime
  validUntil      DateTime?
  status          String @default("DRAFT")
  currency        String          @default("INR")
  
  // Business snapshot
  businessName    String?
  businessGstin   String?
  businessAddress String?
  businessLogo    String?
  
  // Client snapshot
  clientName      String
  clientEmail     String?
  clientPhone     String?
  clientGstin     String?
  clientAddress   String?
  
  // Financial
  subtotal        Float           @default(0)
  discountAmount  Float           @default(0)
  taxAmount       Float           @default(0)
  totalAmount     Float           @default(0)
  
  // Metadata
  notes           String?
  terms           String?
  signature       String?
  templateId      String?
  publicToken     String?         @unique
  viewedAt        DateTime?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Converted invoice reference
  convertedInvoiceId String?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client?         @relation(fields: [clientId], references: [id])
  items           QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  description String
  quantity    Float
  unit        String?
  rate        Float
  discount    Float     @default(0)
  taxRate     Float     @default(0)
  amount      Float
  taxAmount   Float     @default(0)
  total       Float
  sortOrder   Int       @default(0)

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model Template {
  id          String       @id @default(cuid())
  userId      String?
  name        String
  type        String
  isDefault   Boolean      @default(false)
  isPublic    Boolean      @default(true)
  config      String
  preview     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User?        @relation(fields: [userId], references: [id])

  @@map("templates")
}

model Settings {
  id            String   @id @default(cuid())
  userId        String   @unique
  emailHost     String?
  emailPort     Int?
  emailUser     String?
  emailPass     String?
  emailFrom     String?
  invoiceTerms  String?
  quoteTerms    String?
  taxLabel      String   @default("GST")
  dateFormat    String   @default("DD/MM/YYYY")
  timeZone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model ShareLink {
  id        String   @id @default(cuid())
  data      String   // JSON string of full InvoiceData
  title     String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("share_links")
}

// Enums mapped as strings for SQLite compatibility
// InvoiceStatus: DRAFT, SENT, VIEWED, PAID, OVERDUE, CANCELLED
// QuotationStatus: DRAFT, SENT, VIEWED, ACCEPTED, REJECTED, EXPIRED, CONVERTED
// GstType: CGST_SGST, IGST, EXEMPT
// TemplateType: INVOICE, QUOTATION
